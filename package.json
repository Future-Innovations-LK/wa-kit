{
  "name": "@futureinnovationslk/wa-kit",
  "version": "0.1.0",
  "description": "Interactive messages, carousels, newsletters and rich messages on top of official Baileys - no auto-anything.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "author": "Future Innovations LK",
  "license": "MIT",
  "peerDependencies": {
    "baileys": "7.0.0-rc14"
  },
  "devDependencies": {
    "baileys": "7.0.0-rc14",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "buttons",
    "carousel",
    "interactive",
    "newsletter"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
